{
  "name": "mastra-virtual-fs",
  "version": "1.0.2",
  "description": "Mastra Workspace 的内存虚拟文件系统:把 skill 的 SKILL.md / references 以字符串直接喂给 agent,不落盘。",
  "keywords": [
    "mastra",
    "workspace",
    "filesystem",
    "in-memory",
    "virtual-fs",
    "skills",
    "agent"
  ],
  "license": "MIT",
  "author": "Hexi1997 <niudieyi1996@gmail.com>",
  "homepage": "https://github.com/Hexi1997/mastra-virtual-fs",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.ts",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.25.0"
  },
  "devDependencies": {
    "@mastra/core": "1.25.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.7",
    "typescript": "^6.0.0"
  }
}
